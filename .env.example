# Core API Keys
OPENAI_API_KEY=sk-...

# Optional: For Literature Search
NASA_ADS_API_KEY=...

# Optional: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google Gemini
GEMINI_API_KEY=...

# Optional: Local LLM (Ollama / LM Studio)
