# Core API Keys
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
TACC_API_KEY=sk-...
TACC_BASE_URL=https://ai.tejas.tacc.utexas.edu/v1
EXA_API_KEY=your-exa-api-key-here
BRAVE_API_KEY=your-brave-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
SAMBANOVA_API_KEY=your-sambanova-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Auth/session signing. Required in production; use a long random value.
JWT_SECRET=change-me-in-production
QUASAR_ENV=development

# Encrypts user-supplied provider API keys at rest.
# Required when QUASAR_ENV=production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_API_KEY_FERNET_KEY=

# Optional local-only auth testing.
# Never enable these in production. QUASAR_FORCE_LOCAL_DB ignores Turso only
# when QUASAR_ENV is not production, and the test password is stored hashed
# in local SQLite at data/users.db.
QUASAR_FORCE_LOCAL_DB=false
QUASAR_ENABLE_LOCAL_TEST_LOGIN=false
QUASAR_LOCAL_TEST_USERNAME=1@1
QUASAR_LOCAL_TEST_EMAIL=1@1
QUASAR_LOCAL_TEST_DISPLAY_NAME=1
QUASAR_LOCAL_TEST_PASSWORD=1
# Role granted to the seeded local test user (S3). Default 'admin' so local dev
# keeps its admin without a hard-coded email; set 'user' for a non-admin seed.
QUASAR_LOCAL_TEST_ROLE=admin

# ── Admin access (S3) ─────────────────────────────────────────────────
# There is NO hard-coded admin. Grant admin either by listing emails here
# (comma-separated) or by setting role='admin' on a row in the users table.
ADMIN_EMAILS=
# Seconds to cache a user's DB admin-role lookup (hot quota path). Default 60.
# A revoked admin can linger for up to this long; set 0 to disable the cache.
QUASAR_ADMIN_ROLE_CACHE_TTL=60
# Override the local users SQLite path (default data/users.db). Keeps auth.py
# and admin_access.py pointed at the same DB; ignored when Turso is configured.
# QUASAR_USERS_DB_PATH=

# ── Login rate limiting (S6) ──────────────────────────────────────────
# Per-username lockout after too many failed attempts (per worker process).
QUASAR_LOGIN_MAX_ATTEMPTS=5
QUASAR_LOGIN_WINDOW_SECONDS=300
QUASAR_LOGIN_LOCKOUT_SECONDS=300
# Hard cap on distinct identities tracked by each limiter (LRU-evicted) so the
# unauthenticated login endpoint can't be used to exhaust memory.
QUASAR_LOGIN_MAX_TRACKED_KEYS=4096
QUASAR_LOGIN_IP_MAX_TRACKED_KEYS=4096
# Per-source-IP lockout (second dimension; catches username spraying). Looser
# defaults so shared NAT/proxy users aren't punished by one bad actor. Both
# limiters are per-process defense-in-depth — a distributed attack still needs
# an edge/WAF limiter. Throttled logins return HTTP 429 + Retry-After.
QUASAR_LOGIN_IP_MAX_ATTEMPTS=20
QUASAR_LOGIN_IP_WINDOW_SECONDS=300
QUASAR_LOGIN_IP_LOCKOUT_SECONDS=300
# X-Forwarded-For is client-forgeable: it is honored ONLY when this is 1 (set it
# on deployments behind a trusted ingress, e.g. Render). Default: socket peer.
QUASAR_TRUST_XFF=0
# How many trusted proxies sit in front of the app. Each proxy APPENDS the peer
# it received from, so the entry OUR proxy wrote is the Nth from the right —
# everything to its left is client-supplied and forgeable. Only change this if
# you actually add another trusted hop (e.g. Cloudflare in front of Render).
QUASAR_TRUSTED_PROXY_HOPS=1

# ── Auth cookie (S6 — WIRED; see services/auth_cookie.py) ─────────────
# The JWT is delivered as an httpOnly cookie on login/register/google and read
# by the API auth deps (Bearer still accepted). The frontend no longer persists
# tokens in localStorage. SameSite/Secure auto-resolve from QUASAR_ENV
# (dev: Lax; production: None+Secure — the deployed frontend and API are
# cross-site). NOTE: with SameSite=None, an Origin-check/CSRF middleware is a
# scheduled follow-up; until then CORS preflight covers JSON endpoints.
# QUASAR_AUTH_COOKIE_NAME=quasar_auth
# QUASAR_AUTH_COOKIE_SAMESITE=lax        # lax | strict | none  (none => Secure forced)
# QUASAR_AUTH_COOKIE_SECURE=              # 1/0; forced on in prod or when SameSite=none
# QUASAR_AUTH_COOKIE_DOMAIN=

# Optional: For Literature Search
NASA_ADS_API_KEY=...

# Optional: OpenAlex Scholarly Data (free key at openalex.org/settings/api)
OPENALEX_API_KEY=...

# Optional: ALMA QA2 lookup and exact paper-linking behavior
QUASAR_QA2_MAX_LOOKUP=40
QUASAR_QA2_MAX_WORKERS=40
QUASAR_QA2_CACHE_TTL_DAYS=30
QUASAR_AUTO_LINK_PROJECT_PAPERS=true

# Splatalogue/ALMA Spectral Line Explorer (enabled by default; set to false/0/no/off to disable)
ENABLE_SPECTRAL_LINE_EXPLORER=true
SPECTRAL_LINE_JOB_TTL_SECONDS=3600
SPECTRAL_LINE_GLOBAL_WORKERS=2
SPECTRAL_LINE_MAX_ROWS=50000
# Optional official ALMA TAP base URL override, e.g. https://almascience.eso.org/tap
SPECTRAL_LINE_ALMA_TAP_URL=
# Test-only: allows public live smoke queries against Splatalogue and ALMA TAP
RUN_LIVE_SPECTRAL_LINE_TESTS=0

# Optional: Anthropic Claude
# Claude models appear in the picker locally by default and are hidden on the
# deployed (production) service. Set QUASAR_ENABLE_ANTHROPIC=1 to force them on
# (e.g. in production once a key is set) or =0 to hide them locally.
# QUASAR_ANTHROPIC_MODELS overrides which Claude IDs are offered.
ANTHROPIC_API_KEY=sk-ant-...
QUASAR_ENABLE_ANTHROPIC=
QUASAR_ANTHROPIC_MODELS=claude-opus-4-8,claude-sonnet-5,claude-haiku-4-5

# Optional: Google Gemini
GEMINI_API_KEY=...

# Optional: Local LLM (Ollama / LM Studio)
# Set this to use self-hosted models (e.g. DeepSeek, Llama, Mistral)
# Ollama default: http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=

# Optional: Texas Advanced Computing Center / Tejas model routing
# Use these to run Quasar's main and internal agent calls on TACC models.
DEFAULT_LLM_MODEL=gpt-oss-120b
QUASAR_OPENAI_MODELS=gpt-5.4-mini,gpt-4.1,gpt-4o-mini
QUASAR_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
QUASAR_TACC_MODELS=gpt-oss-120b,Qwen3-32B,gemma-4-31B-it
QUASAR_GPT_OSS_REASONING=high
QUASAR_TOKEN_LIMIT_EXEMPT_EMAILS=
QUASAR_FAST_MODEL=gpt-oss-120b
QUASAR_REASONING_MODEL=gpt-oss-120b
QUASAR_CONDUCTOR_MODEL=gpt-oss-120b
QUASAR_SYNTHESIS_MODEL=gpt-oss-120b
QUASAR_COMPLEXITY_MODEL=gpt-oss-120b
QUASAR_WEB_INTENT_MODEL=gpt-oss-120b
QUASAR_PAPER_INTENT_MODEL=gpt-oss-120b
QUASAR_WEB_SYNTHESIS_MODEL=gpt-oss-120b
QUASAR_SUMMARY_MODEL=gpt-oss-120b
QUASAR_MEMORY_EXTRACTION_MODEL=gpt-oss-120b
QUASAR_PERSONAL_MEMORY_MODEL=gpt-oss-120b
QUASAR_PDF_MODEL=gpt-oss-120b
QUASAR_PROPOSAL_CRITIC_MODEL=gpt-oss-120b
TACC_KEY_TEST_MODEL=Meta-Llama-3.2-1B-Instruct
TACC_STREAM_INCLUDE_USAGE=true
TACC_ENABLE_RESPONSE_FORMAT=false
QUASAR_TACC_FALLBACK_MODEL=none

# Chat reliability and provider transport bounds
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_READ_TIMEOUT_SECONDS=90
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=15
CHAT_INACTIVITY_TIMEOUT_SECONDS=90
CHAT_STANDARD_TIMEOUT_SECONDS=240
CHAT_CONDUCTOR_TIMEOUT_SECONDS=360
CHAT_WORKER_THREADS=4
TOOL_PROGRESS_HEARTBEAT_SECONDS=15

# Optional: Multimodal Universe HATS catalogs (lsdb + Hugging Face)
# Datasets are public; a read-only HF token just lifts anonymous rate limits
# (useful on shared-egress hosts like Render). Canonical name is HF_TOKEN;
# the HF_token spelling is also accepted (mapped in services/mmu_hats.py).
ENABLE_MMU_HATS=true
HF_TOKEN=
# MMU_HATS_CACHE_DIR=cache/mmu_hats
# MMU_HATS_MAX_RADIUS_ARCSEC=3600
# MMU_HATS_MAX_ROWS=5000

# Optional: WhatsApp Business API Integration
# See: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=quasar_whatsapp_verify

# ── Observability ─────────────────────────────────────────────────────

# Optional: Helicone (LLM cost analytics proxy — zero code change)
# Routes all OpenAI calls through Helicone for automatic cost tracking.
# Sign up free (100k req/month): https://helicone.ai
HELICONE_API_KEY=

# Optional: Langfuse (Full agent tracing & observability)
# Traces every LLM call and Conductor DAG execution with nested spans.
# Sign up free (50k obs/month): https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Rollbar (Error tracking with trace correlation)
# Errors are tagged with quasar.trace_id and quasar.tool for filtering.
# Sign up free: https://rollbar.com
ROLLBAR_ACCESS_TOKEN=
# Strict filtering for untrusted general-web results. Keep enabled in production.
QUASAR_STRICT_WEB_FILTER=true
# General-web image tiles are on by default. Archive and locally rendered images still work.
QUASAR_WEB_IMAGES_ENABLED=true  # Opt-out: set false only to disable web image tiles.
