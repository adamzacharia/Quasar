# Core API Keys
OPENAI_API_KEY=sk-...
EXA_API_KEY=your-exa-api-key-here
BRAVE_API_KEY=your-brave-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Auth/session signing. Required in production; use a long random value.
JWT_SECRET=change-me-in-production
QUASAR_ENV=development

# Optional local-only auth testing.
# Never enable these in production. QUASAR_FORCE_LOCAL_DB ignores Turso only
# when QUASAR_ENV is not production, and the test password is stored hashed
# in local SQLite at data/users.db.
QUASAR_FORCE_LOCAL_DB=false
QUASAR_ENABLE_LOCAL_TEST_LOGIN=false
QUASAR_LOCAL_TEST_USERNAME=1@1
QUASAR_LOCAL_TEST_EMAIL=1@1
QUASAR_LOCAL_TEST_DISPLAY_NAME=1
QUASAR_LOCAL_TEST_PASSWORD=1

# Optional: For Literature Search
NASA_ADS_API_KEY=...

# Optional: OpenAlex Scholarly Data (free key at openalex.org/settings/api)
OPENALEX_API_KEY=...

# Optional: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google Gemini
GEMINI_API_KEY=...

# Optional: Local LLM (Ollama / LM Studio)
# Set this to use self-hosted models (e.g. DeepSeek, Llama, Mistral)
# Ollama default: http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=

# Optional: WhatsApp Business API Integration
# See: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=quasar_whatsapp_verify

# ── Observability ─────────────────────────────────────────────────────

# Optional: Helicone (LLM cost analytics proxy — zero code change)
# Routes all OpenAI calls through Helicone for automatic cost tracking.
# Sign up free (100k req/month): https://helicone.ai
HELICONE_API_KEY=

# Optional: Langfuse (Full agent tracing & observability)
# Traces every LLM call and Conductor DAG execution with nested spans.
# Sign up free (50k obs/month): https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Rollbar (Error tracking with trace correlation)
# Errors are tagged with quasar.trace_id and quasar.tool for filtering.
# Sign up free: https://rollbar.com
ROLLBAR_ACCESS_TOKEN=
