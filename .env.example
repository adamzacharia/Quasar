# Core API Keys
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
TACC_API_KEY=sk-...
TACC_BASE_URL=https://ai.tejas.tacc.utexas.edu/v1
EXA_API_KEY=your-exa-api-key-here
BRAVE_API_KEY=your-brave-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Auth/session signing. Required in production; use a long random value.
JWT_SECRET=change-me-in-production
QUASAR_ENV=development

# Encrypts user-supplied provider API keys at rest.
# Required when QUASAR_ENV=production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_API_KEY_FERNET_KEY=

# Optional local-only auth testing.
# Never enable these in production. QUASAR_FORCE_LOCAL_DB ignores Turso only
# when QUASAR_ENV is not production, and the test password is stored hashed
# in local SQLite at data/users.db.
QUASAR_FORCE_LOCAL_DB=false
QUASAR_ENABLE_LOCAL_TEST_LOGIN=false
QUASAR_LOCAL_TEST_USERNAME=1@1
QUASAR_LOCAL_TEST_EMAIL=1@1
QUASAR_LOCAL_TEST_DISPLAY_NAME=1
QUASAR_LOCAL_TEST_PASSWORD=1

# Optional: For Literature Search
NASA_ADS_API_KEY=...

# Optional: OpenAlex Scholarly Data (free key at openalex.org/settings/api)
OPENALEX_API_KEY=...

# Optional: ALMA QA2 lookup and exact paper-linking behavior
QUASAR_QA2_MAX_LOOKUP=40
QUASAR_QA2_MAX_WORKERS=40
QUASAR_QA2_CACHE_TTL_DAYS=30
QUASAR_AUTO_LINK_PROJECT_PAPERS=true

# Feature-gated Splatalogue/ALMA Spectral Line Explorer
ENABLE_SPECTRAL_LINE_EXPLORER=false
SPECTRAL_LINE_JOB_TTL_SECONDS=3600
SPECTRAL_LINE_GLOBAL_WORKERS=2
SPECTRAL_LINE_MAX_ROWS=50000
# Optional official ALMA TAP base URL override, e.g. https://almascience.eso.org/tap
SPECTRAL_LINE_ALMA_TAP_URL=
# Test-only: allows public live smoke queries against Splatalogue and ALMA TAP
RUN_LIVE_SPECTRAL_LINE_TESTS=0

# Optional: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Google Gemini
GEMINI_API_KEY=...

# Optional: Local LLM (Ollama / LM Studio)
# Set this to use self-hosted models (e.g. DeepSeek, Llama, Mistral)
# Ollama default: http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=

# Optional: Texas Advanced Computing Center / Tejas model routing
# Use these to run Quasar's main and internal agent calls on TACC models.
DEFAULT_LLM_MODEL=gpt-oss-120b
QUASAR_OPENAI_MODELS=gpt-5.4-mini,gpt-4.1,gpt-4o-mini
QUASAR_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
QUASAR_TACC_MODELS=gpt-oss-120b,Qwen3-32B,gemma-4-31B-it
QUASAR_TOKEN_LIMIT_EXEMPT_EMAILS=
QUASAR_FAST_MODEL=gpt-oss-120b
QUASAR_REASONING_MODEL=gpt-oss-120b
QUASAR_CONDUCTOR_MODEL=gpt-oss-120b
QUASAR_SYNTHESIS_MODEL=gpt-oss-120b
QUASAR_COMPLEXITY_MODEL=gpt-oss-120b
QUASAR_WEB_INTENT_MODEL=gpt-oss-120b
QUASAR_PAPER_INTENT_MODEL=gpt-oss-120b
QUASAR_WEB_SYNTHESIS_MODEL=gpt-oss-120b
QUASAR_SUMMARY_MODEL=gpt-oss-120b
QUASAR_MEMORY_EXTRACTION_MODEL=gpt-oss-120b
QUASAR_PERSONAL_MEMORY_MODEL=gpt-oss-120b
QUASAR_PDF_MODEL=gpt-oss-120b
QUASAR_PROPOSAL_CRITIC_MODEL=gpt-oss-120b
TACC_KEY_TEST_MODEL=Meta-Llama-3.2-1B-Instruct
TACC_STREAM_INCLUDE_USAGE=true
TACC_ENABLE_RESPONSE_FORMAT=false
QUASAR_TACC_FALLBACK_MODEL=none

# Optional: WhatsApp Business API Integration
# See: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=quasar_whatsapp_verify

# ── Observability ─────────────────────────────────────────────────────

# Optional: Helicone (LLM cost analytics proxy — zero code change)
# Routes all OpenAI calls through Helicone for automatic cost tracking.
# Sign up free (100k req/month): https://helicone.ai
HELICONE_API_KEY=

# Optional: Langfuse (Full agent tracing & observability)
# Traces every LLM call and Conductor DAG execution with nested spans.
# Sign up free (50k obs/month): https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Rollbar (Error tracking with trace correlation)
# Errors are tagged with quasar.trace_id and quasar.tool for filtering.
# Sign up free: https://rollbar.com
ROLLBAR_ACCESS_TOKEN=
