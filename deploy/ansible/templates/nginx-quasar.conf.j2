# Managed by Ansible (deploy/ansible).
# Front door for Quasar. SSE requirements (per the TACC thread): response
# buffering OFF and long-lived connections (read timeout >= 600 s) so
# Server-Sent Events stream instead of being cut off mid-response.

server {
    listen 80;
    listen [::]:80;
    server_name {{ quasar_server_name }};

    client_max_body_size {{ quasar_client_max_body_size }};

    # ── Backend API (SSE lives here: POST /api/chat streams events) ──
    location /api/ {
        proxy_pass http://127.0.0.1:{{ quasar_backend_port }};

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE: never buffer, never cache, allow hour-long streams.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout {{ quasar_proxy_read_timeout }}s;
        send_timeout {{ quasar_proxy_read_timeout }}s;
    }

{% if quasar_deploy_frontend %}
    # ── Next.js frontend ─────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:{{ quasar_frontend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
{% else %}
    # Backend-only VM (frontend stays on Vercel): everything else 404s.
    location / {
        return 404;
    }
{% endif %}
}
